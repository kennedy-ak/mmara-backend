# MMara Backend Environment Variables

# Application
APP_NAME=MMara Legal AI
DEBUG=false
ENVIRONMENT=development

# API Configuration
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# Database (PostgreSQL)
# IMPORTANT: Use strong unique passwords in production!
DATABASE_URL=postgresql+asyncpg://mmara:CHANGE_THIS_PASSWORD@localhost:5432/mmara
DATABASE_ECHO=false

# Redis
# Format: redis://[:password@]localhost:6379/0
# For Redis with password: redis://:your-password@localhost:6379/0
# For Redis over SSL: rediss://[:password@]localhost:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
REDIS_MAX_CONNECTIONS=50

# JWT Authentication
# IMPORTANT: Generate a secure random key for production!
# Use: openssl rand -hex 32 or python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_USE_openssl_rand_hex_32_TO_GENERATE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=2000

# Embeddings (OpenAI)
EMBEDDING_MODEL=text-embedding-3-small

# LlamaParse
LLAMAPARSE_API_KEY=your-llamaparse-api-key-here

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=mmara-legal
PINECONE_NAMESPACE=legal_documents

# Document Paths
CRIMINAL_DOCS_PATH=../Criminal_proceeding
ROAD_TRAFFIC_DOCS_PATH=../Road_traffic

# Retrieval Parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
RETRIEVAL_ALPHA=0.7
RRF_K=60

# Rate Limiting
RATE_LIMIT_FREE=50
RATE_LIMIT_AUTH=500
RATE_LIMIT_PREMIUM=-1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Email Configuration (for password reset)
FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@mmara.ai
SMTP_FROM_NAME=MMara Legal AI
