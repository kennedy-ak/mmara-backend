# MMara Backend Environment Variables

# Application
APP_NAME=MMara Legal AI
DEBUG=false
ENVIRONMENT=development

# API Configuration
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://mmara:mmara@localhost:5432/mmara
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# JWT Authentication
SECRET_KEY=change-this-secret-key-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Groq API
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=2000

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=legal_documents

# Document Paths
CRIMINAL_DOCS_PATH=../Criminal_proceeding
ROAD_TRAFFIC_DOCS_PATH=../Road_traffic

# Retrieval Parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
RETRIEVAL_ALPHA=0.7
RRF_K=60

# Rate Limiting
RATE_LIMIT_FREE=50
RATE_LIMIT_AUTH=500
RATE_LIMIT_PREMIUM=-1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
